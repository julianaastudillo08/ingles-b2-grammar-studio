{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.mjs",
      "ultra-bank.js",
      "data-extra.js",
      "writing-extra.js",
      "mega-bank.js",
      "build-one-page.mjs",
      "validate-app.mjs",
      "reorder-sections.mjs",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
